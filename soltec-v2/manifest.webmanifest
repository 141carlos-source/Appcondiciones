{
  "name": "SOLTEC Avisos V2",
  "short_name": "SOLTEC V2",
  "description": "Avisos, expedientes y agenda de Soltec Instalaciones",
  "lang": "es",
  "start_url": "./#/inicio",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f2ee",
  "theme_color": "#ffffff",
  "share_target": {
    "action": "./recibir-ficha",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url", "files": [{ "name": "ficha", "accept": ["application/pdf", ".pdf"] }] }
  },
  "file_handlers": [{ "action": "./index.html", "accept": { "application/pdf": [".pdf"] } }],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
